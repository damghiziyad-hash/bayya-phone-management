msgid "Tableau de bord"
msgstr "لوحة التحكم"

msgid "Connexion"
msgstr "تسجيل الدخول"

msgid "Connectez-vous pour accéder à la gestion du magasin."
msgstr "سجّل الدخول للوصول إلى إدارة المتجر."

msgid "Nom d'utilisateur"
msgstr "اسم المستخدم"

msgid "Mot de passe"
msgstr "كلمة المرور"

msgid "Se connecter"
msgstr "دخول"

msgid "Se déconnecter"
msgstr "تسجيل الخروج"

