msgstr "قيمة المخزون (بسعر الشراء)"

msgid "Produits à surveiller"
msgstr "منتجات تحتاج إلى متابعة"

msgid "Produit"
msgstr "المنتج"

msgid "Quantité"
msgstr "الكمية"

msgid "Seuil"
msgstr "الحد الأدنى"

msgid "Emplacement"
msgstr "الموقع"

msgid "Statut"
msgstr "الحالة"

msgid "Aucun produit à surveiller : tous les stocks sont au-dessus de leur seuil."
msgstr "لا توجد منتجات تحتاج إلى متابعة: جميع المخزونات فوق حدّها الأدنى."

msgid "Derniers mouvements de stock"
msgstr "آخر حركات المخزون"

msgid "Date"
msgstr "التاريخ"

msgid "Type"
msgstr "النوع"

msgid "Utilisateur"
msgstr "المستخدم"

msgid "Aucun mouvement de stock enregistré."
msgstr "لا توجد حركات مخزون مسجّلة."

msgid "Définitions"
msgstr "التعريفات"

msgid "Références actives : produits non archivés."
msgstr "المراجع النشطة: المنتجات غير المؤرشفة."

msgid "Quantité totale : somme des quantités des produits actifs."
msgstr "الكمية الإجمالية: مجموع كميات المنتجات النشطة."

msgid "Stock faible : quantité comprise entre 1 et le seuil d'alerte du produit."
msgstr "مخزون منخفض: كمية بين 1 وحدّ التنبيه الخاص بالمنتج."

msgid "Rupture : quantité égale à 0."
msgstr "نفاد: الكمية تساوي 0."

msgid "Valeur du stock : quantité × prix d'achat, produits actifs seulement."
msgstr "قيمة المخزون: الكمية × سعر الشراء، للمنتجات النشطة فقط."

msgid "Accès refusé"
msgstr "الوصول مرفوض"

msgid "Vous n'avez pas la permission d'accéder à cette page."
msgstr "ليست لديك صلاحية الوصول إلى هذه الصفحة."

msgid "Retour à l'accueil"
msgstr "العودة إلى الصفحة الرئيسية"

msgid "Propriétaire / administrateur"
msgstr "المالك / المدير"

msgid "Gestionnaire de stock"
msgstr "مسؤول المخزون"

msgid "Vendeur / caissier"
msgstr "بائع / أمين الصندوق"

msgid "Entrée"
msgstr "إدخال"

msgid "Sortie"
msgstr "إخراج"

msgid "Ajustement positif"
msgstr "تعديل بالزيادة"

msgid "Ajustement négatif"
msgstr "تعديل بالنقصان"
