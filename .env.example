# Copier vers .env (jamais commité) puis remplacer les valeurs.
# Générer une clé : python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=remplacer-par-une-longue-cle-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production : https://votre-domaine.example (séparés par des virgules)
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Casablanca

# Base de données : "postgresql" (défaut) ou "sqlite" (essais rapides uniquement)
DB_ENGINE=postgresql
DB_NAME=bayya_phone
DB_USER=bayya_user
DB_PASSWORD=remplacer-par-un-mot-de-passe
DB_HOST=localhost
DB_PORT=5432

# Production uniquement (DEBUG=False)
DJANGO_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
